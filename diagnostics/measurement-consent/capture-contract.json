{
  "schemaVersion": 2,
  "proposalOnly": true,
  "executesCapture": false,
  "predicate": "subsystem == \"dev.roominthecart.measurementconsentdiagnostic\" AND category == \"events\"",
  "format": "compact",
  "level": "info",
  "process": "RoomInTheCart",
  "artifacts": [
    "live stdout",
    "live stderr",
    "bounded persisted export stdout",
    "persisted export stderr",
    "collector startup/finalization statuses",
    "liveness observations",
    "original xcresult and test log",
    "source/product hashes"
  ],
  "neverCollect": [
    "unfiltered system logs",
    "environment dumps",
    "credentials",
    "domain identifiers"
  ],
  "livenessProvesExhaustiveDelivery": false,
  "persistedExportSuccessProvesExhaustiveDelivery": false,
  "equalObservedEventSetsProveExhaustiveDelivery": false,
  "missingSetterProvesNoSetter": false,
  "timestampRepresentation": "raw OSLog timestamp, without an inferred timezone",
  "sourceTimezones": {
    "live": "unknown unless independently established",
    "export": "UTC only when log show --timezone UTC was actually used"
  },
  "streamTimezoneOptionSupported": false
}
