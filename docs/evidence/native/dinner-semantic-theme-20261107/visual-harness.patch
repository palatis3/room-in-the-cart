+    private func captureDinnerThemeState(_ state: String, appearance: String) throws {
+        let name = "Dinner-theme-\(appearance)-\(state)"
+        let snapshot = try app.snapshot()
+        var pending = [snapshot]
+        var nodes: [[String: Any]] = []
+        while let node = pending.popLast() {
+            let frame = node.frame
+            if !frame.isEmpty && frame.intersects(snapshot.frame),
+               [frame.minX, frame.minY, frame.width, frame.height].allSatisfy({ $0.isFinite }) {
+                nodes.append(["type": node.elementType.rawValue, "identifier": node.identifier,
+                              "label": node.label, "value": node.value.map { String(describing: $0) } ?? "",
+                              "framePoints": [frame.minX, frame.minY, frame.width, frame.height]])
+            }
+            pending.append(contentsOf: node.children)
+        }
+        XCTAssertGreaterThan(nodes.count, 1, "Retain actual AX descendants for screenshot interpretation")
+        let facts: [String: Any] = [
+            "appearanceArgument": appearance, "state": state, "locale": "en_US",
+            "appFramePoints": [snapshot.frame.minX, snapshot.frame.minY, snapshot.frame.width, snapshot.frame.height],
+            "keyboardPresent": app.keyboards.firstMatch.exists, "nodes": nodes,
+            "coordinateNote": "AX frames are screen points. Convert using actual PNG dimensions; sample opaque interiors away from antialiasing, rounded edges and system bars. Appearance argument is requested mode, not independent proof of rendered colors."
+        ]
+        let data = try JSONSerialization.data(withJSONObject: facts, options: [.prettyPrinted, .sortedKeys])
+        let bounds = XCTAttachment(string: String(decoding: data, as: UTF8.self))
+        bounds.name = name + "-AX-bounds.json"; bounds.lifetime = .keepAlways; add(bounds)
+        capture(name)
+    }
+
