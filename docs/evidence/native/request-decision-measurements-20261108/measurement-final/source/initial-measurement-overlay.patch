+    private func measureRequestDecision(category: UIContentSizeCategory, argument: String, name: String) throws {
+        openCerealReview(extraArguments: ["-UIPreferredContentSizeCategoryName", argument])
+        // The exact combined AX row parents are present in the original grouped
+        // audit (reports 3/4); never match a global amount or the input field.
+        let rows: [(key: String, title: String, value: String, identifier: String?)] = [
+            ("after", "Expected total", "$40.69", "household.decision.after-total"),
+            ("over", "Over cap", "$2.69", "household.decision.over-cap"),
+            ("before", "Before this decision", "$37.20", "household.decision.before-total"),
+            ("change", "Cost change", "$3.49", nil),
+            ("cap", "Cap", "$38.00", nil),
+        ]
+        for spec in rows {
+            let query: XCUIElementQuery
+            if let identifier = spec.identifier {
+                query = app.descendants(matching: .any).matching(identifier: identifier)
+            } else {
+                query = app.staticTexts.matching(NSPredicate(format: "label == %@", spec.title + ", " + spec.value))
+            }
+            let row = query.firstMatch
+            centerForReading(row)
+            XCTAssertEqual(query.count, 1, "Ambiguous money row: " + spec.key)
+            XCTAssertEqual(row.label, spec.title + ", " + spec.value)
+            let values = row.staticTexts.matching(NSPredicate(format: "label == %@", spec.value))
+            XCTAssertEqual(values.count, 1, "Missing unique descendant amount: " + spec.key)
+            let value = values.firstMatch
+            try captureRequestDecisionMeasurement(value, owner: row, key: spec.key, size: name,
+                category: category, launchArgument: argument, cropScope: "exact amount child of exact combined row",
+                moneyReference: true)
+        }
+
+        let reviewQuery = app.buttons.matching(identifier: "household.decision.review")
+        let review = reviewQuery.firstMatch
+        centerForReading(review)
+        XCTAssertEqual(reviewQuery.count, 1)
+        XCTAssertEqual(review.label, "Review decision")
+        XCTAssertTrue(review.isEnabled)
+        // Plain text button crop intentionally includes its padding. The raw ink
+        // algorithm reports bounds within that crop; it does not call it a font.
+        try captureRequestDecisionMeasurement(review, owner: review, key: "review-decision", size: name,
+            category: category, launchArgument: argument, cropScope: "whole plain text button including padding",
+            moneyReference: false)
+        let headingQuery = app.staticTexts.matching(NSPredicate(format: "label == %@", "Review before applying"))
+        let heading = headingQuery.firstMatch
+        centerForReading(heading)
+        XCTAssertEqual(headingQuery.count, 1)
+        try captureRequestDecisionMeasurement(heading, owner: heading, key: "review-heading", size: name,
+            category: category, launchArgument: argument, cropScope: "section heading static text including padding",
+            moneyReference: false)
+
+        // No apply, overage acceptance, repeated review, or other domain mutation.
+        tap(element("household.decision.cancel"))
+        let request = element("household.request.44444444-4444-4444-8444-444444444444")
+        XCTAssertTrue(request.waitForExistence(timeout: 5))
+        XCTAssertTrue(request.label.contains("Received, waiting for review"))
+        XCTAssertEqual(element("fixture.s24.posts").label, "Fixture applied decisions: 0")
+        XCTAssertEqual(element("fixture.s24.lines").label, "Fixture saved lines: 0")
+        capture("S24-measure-" + name + "-cancel-zero-writes")
+    }
