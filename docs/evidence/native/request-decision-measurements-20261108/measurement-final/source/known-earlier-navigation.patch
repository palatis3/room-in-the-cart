+    private func revealKnownEarlierMeasurementTarget(_ target: XCUIElement) -> Bool {
+        // Measurement-only navigation: preserve the existing 24-drag budget,
+        // but search toward the known earlier row while its frame is absent.
+        for _ in 0..<24 {
+            if target.exists && target.isHittable { return true }
+            let area = scrollableArea()
+            let upward: Bool
+            if target.exists && !target.frame.isEmpty {
+                upward = target.frame.midY > area.midY
+            } else {
+                upward = false
+            }
+            scrollContent(upward: upward)
+        }
+        let actionable = target.exists && target.isHittable
+        XCTAssertTrue(actionable, "Missing known earlier measurement target: \(target.debugDescription)")
+        return actionable
     }
 
