+#if DEBUG && CONTRIBUTOR_CAPTURE_UI_FIXTURE && SPEECH_CALL_TIMING_DIAGNOSTIC
+// Diagnostic values are numeric only. No cook text, playback/business UUIDs, audio or errors.
+// Domain1 is confined to MainActor; domain2 to the pre-existing audio-session serial queue.
+// No new synchronization, queue, timer, observer, or speech ownership is introduced.
+private struct CookSpeechCallTiming {
+    enum Operation: Int {
+        case prepareAudio = 1, speakMethod, installedVoices, speakAPI, pauseAPI
+        case resumeMethod, stopMethod, stopAPI, acquireQueue, activateScope
+        case releaseQueue, deactivateAPI
+    }
+    struct Token {
+        let call: Int
+        let operation: Operation
+        let issued: UInt64
+        let begin: UInt64
+        let queued: UInt64
+    }
+    private static let enabled: Bool = {
+        let process = ProcessInfo.processInfo
+        return process.arguments.contains("--ui-testing") &&
+            process.arguments.contains("--shared-delivery-fixture") &&
+            process.environment["SPEECH_CALL_TIMING_SCOPE"] ==
+                "SharedDeliveryUITests/testShopperReviewsExactEditedCookWordingBeforeReadback"
+    }()
+    private static let logger = Logger(subsystem: "dev.roominthecart.diagnostics", category: "speech-call-timing")
+    let domain: Int
+    private var issuedCalls = 0
+    private var capReported = false
+
+    init(domain: Int) { self.domain = domain }
+    static func clockIfEnabled() -> UInt64 { enabled ? DispatchTime.now().uptimeNanoseconds : 0 }
+
+    mutating func begin(_ operation: Operation, queuedAt: UInt64 = 0) -> Token? {
+        guard Self.enabled else { return nil }
+        guard issuedCalls < 64 else {
+            if !capReported {
+                capReported = true
+                emit(call: 0, op: 0, phase: 2, issued: DispatchTime.now().uptimeNanoseconds,
+                     begin: 0, end: 0, queued: 0)
+            }
+            return nil
+        }
+        issuedCalls += 1
+        let issued = DispatchTime.now().uptimeNanoseconds
+        emit(call: issuedCalls, op: operation.rawValue, phase: 0, issued: issued,
+             begin: 0, end: 0, queued: queuedAt)
+        // Start AFTER entry logging; finish BEFORE exit logging to exclude both log writes.
+        return Token(call: issuedCalls, operation: operation, issued: issued,
+                     begin: DispatchTime.now().uptimeNanoseconds, queued: queuedAt)
+    }
+    func end(_ token: Token?) {
+        guard let token else { return }
+        let end = DispatchTime.now().uptimeNanoseconds
+        emit(call: token.call, op: token.operation.rawValue, phase: 1, issued: token.issued,
+             begin: token.begin, end: end, queued: token.queued)
+    }
+    private func emit(call: Int, op: Int, phase: Int, issued: UInt64,
+                      begin: UInt64, end: UInt64, queued: UInt64) {
+        let pid = ProcessInfo.processInfo.processIdentifier
+        let main = Thread.isMainThread ? 1 : 0
+        Self.logger.notice("SPEECH_CALL_TIMING v=1 domain=\(domain, privacy: .public) call=\(call, privacy: .public) op=\(op, privacy: .public) phase=\(phase, privacy: .public) pid=\(pid, privacy: .public) main=\(main, privacy: .public) issued=\(issued, privacy: .public) begin=\(begin, privacy: .public) end=\(end, privacy: .public) queued=\(queued, privacy: .public)")
+    }
+}
+#endif
