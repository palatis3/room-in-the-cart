+/// The factory is Sendable; its returned engine is deliberately NOT Sendable.
+/// Creation, every method/property access, and release happen inside the owner.
+protocol CookNativeEngine: AnyObject {
+    var isSpeaking: Bool { get }
+    var isPaused: Bool { get }
+    func start(text: String, voice: AVSpeechSynthesisVoice?, startBefore: Date, generation: UUID, utterance: UUID,
+               terminal: @escaping @Sendable (CookNativeTerminal) -> Void) -> Bool
+    func pause() -> Bool
+    func resume() -> Bool
+    func stop() -> Bool
+    func clearUtterance()
+}
+
+/// Callback executor is unspecified. Verify native identity without reading native
+/// properties; forward immutable generation/token only. The delegate owns no native object.
+private final class CookNativeDelegate: NSObject, AVSpeechSynthesizerDelegate, @unchecked Sendable {
+    let nativeIdentity: ObjectIdentifier
+    let identity: CookNativeTerminal
+    let terminal: @Sendable (CookNativeTerminal) -> Void
+    init(nativeIdentity: ObjectIdentifier, identity: CookNativeTerminal,
+         terminal: @escaping @Sendable (CookNativeTerminal) -> Void) {
+        self.nativeIdentity = nativeIdentity; self.identity = identity; self.terminal = terminal
+    }
+    func speechSynthesizer(_ synthesizer: AVSpeechSynthesizer, didFinish utterance: AVSpeechUtterance) {
+        if ObjectIdentifier(utterance) == nativeIdentity { terminal(identity) }
+    }
+    func speechSynthesizer(_ synthesizer: AVSpeechSynthesizer, didCancel utterance: AVSpeechUtterance) {
+        if ObjectIdentifier(utterance) == nativeIdentity { terminal(identity) }
+    }
+}
+
+/// Only the owner-thread factory constructs this engine. Native objects never
+/// leave it; the delegate captures identifiers, never the utterance or synthesizer.
+private final class CookAVSpeechEngine: CookNativeEngine {
+    private let owner = Thread.current
+    private let synthesizer: AVSpeechSynthesizer
+    private var utterance: AVSpeechUtterance?
+    private var delegate: CookNativeDelegate?
+    init() {
+        precondition(!Thread.isMainThread)
+        synthesizer = AVSpeechSynthesizer(); synthesizer.usesApplicationAudioSession = true
+    }
+    private func assertOwner() { precondition(Thread.current == owner && !Thread.isMainThread) }
+    var isSpeaking: Bool { assertOwner(); return synthesizer.isSpeaking }
+    var isPaused: Bool { assertOwner(); return synthesizer.isPaused }
+    func start(text: String, voice: AVSpeechSynthesisVoice?, startBefore: Date, generation: UUID, utterance token: UUID,
+               terminal: @escaping @Sendable (CookNativeTerminal) -> Void) -> Bool {
+        assertOwner(); guard let voice else { return false }
+        let utterance = AVSpeechUtterance(string: text)
+        utterance.voice = voice; utterance.rate = AVSpeechUtteranceDefaultSpeechRate
+        let delegate = CookNativeDelegate(nativeIdentity: ObjectIdentifier(utterance),
+            identity: .init(generation: generation, utterance: token), terminal: terminal)
+        self.utterance = utterance; self.delegate = delegate; synthesizer.delegate = delegate
+        guard Date() < startBefore else { clearUtterance(); return false }
+        synthesizer.speak(utterance); return true
+    }
+    func pause() -> Bool { assertOwner(); return synthesizer.pauseSpeaking(at: .immediate) }
+    func resume() -> Bool { assertOwner(); return synthesizer.continueSpeaking() }
+    func stop() -> Bool { assertOwner(); return synthesizer.stopSpeaking(at: .immediate) }
+    func clearUtterance() { assertOwner(); synthesizer.delegate = nil; utterance = nil; delegate = nil }
+    deinit { assertOwner() }
+}
+
+/// This object is created, used and released only inside the dedicated thread.
+/// Framework-held final releases remain outside application ownership guarantees.
+private final class CookNativeCore {
+    private let owner = Thread.current
+    private let bridge: CookNativeBridge
+    private var engine: (any CookNativeEngine)?
+    private var active: CookNativeTerminal?
+    private var terminalSeen: CookNativeTerminal?
+    private var executing = false
+    private var needsDrain = false
+    private(set) var shouldExit = false
+    init(bridge: CookNativeBridge, factory: @Sendable () -> any CookNativeEngine) {
+        precondition(!Thread.isMainThread)
+        self.bridge = bridge; engine = factory()
+    }
+    private func assertOwner() { precondition(Thread.current == owner && !Thread.isMainThread) }
+    private func clearUtterance() {
+        assertOwner(); engine?.clearUtterance()
+        if let active { bridge.clearTerminalRegistration(active) }
+        active = nil; terminalSeen = nil
+    }
+    private var observedIdle: Bool { assertOwner(); return engine.map { !$0.isSpeaking && !$0.isPaused } ?? true }
+    func drain() {
+        assertOwner()
+        // Guard the WHOLE turn: native state getters, clear/release, and calls can
+        // each service nested run loops. A consumed nested source wake is deferred.
+        guard !executing else { needsDrain = true; return }
+        executing = true
+        defer {
+            executing = false
+            let wake = needsDrain && !shouldExit; needsDrain = false
+            if wake { bridge.signalPending() }
+        }
+        processTerminals()
+        guard !shouldExit, let command = bridge.takeNext() else { return }
+        let succeeded = perform(command)
+        bridge.returned(command.ticket, succeeded: succeeded)
+        // Retire matched completion before late Pause/Resume result delivery.
+        processTerminals()
+        bridge.emit(.result(command.ticket, succeeded))
+        if command.ticket.kind == .shutdown && succeeded { shouldExit = true }
+        // At most one follow-up turn after a command, plus consumed nested wakes.
+        // An empty non-reentrant turn does NOT signal itself or spin.
+        needsDrain = true
+    }
+    private func perform(_ command: CookNativeCommand) -> Bool {
+        assertOwner(); guard let engine else { return false }
+        let ticket = command.ticket
+        switch ticket.kind {
+        case .start:
+            guard active == nil, observedIdle, let text = command.text,
+                  let deadline = command.startBefore, Date() < deadline else { return false }
+            let identity = CookNativeTerminal(generation: ticket.generation, utterance: UUID())
+            active = identity // Admit before native start; callbacks may be synchronous.
+            bridge.registerTerminal(identity)
+            let bridge = bridge
+            let accepted = engine.start(text: text, voice: command.voice, startBefore: deadline, generation: identity.generation,
+                utterance: identity.utterance) { bridge.terminal($0) }
+            if !accepted { clearUtterance() }
+            return accepted // API submission returned; not an acoustic-start assertion.
+        case .pause:
+            guard active?.generation == ticket.generation else { return false }
+            return engine.pause()
+        case .resume:
+            guard active?.generation == ticket.generation else { return false }
+            return engine.resume()
+        case .stop, .shutdown:
+            if ticket.kind == .stop, let active, active.generation != ticket.generation { return false }
+            let matchedTerminal = active.map { value in
+                terminalSeen == value
+            } ?? false
+            let stopped = CookSpeechStopPolicy.stop(hasAdmittedUtterance: active != nil, matchedTerminal: matchedTerminal,
+                isSpeaking: engine.isSpeaking, isPaused: engine.isPaused) {
+                    engine.stop()
+                }
+            if stopped { clearUtterance() }
+            // False active Stop remains unacknowledged. A matched terminal event
+            // may separately retire the generation after owner-observed idle.
+            return stopped
+        }
+    }
+    private func processTerminals() {
+        assertOwner(); precondition(executing)
+        for value in bridge.takeTerminals() {
+            guard let active, active.generation == value.generation,
+                  active.utterance == value.utterance else { continue }
+            terminalSeen = value
+            guard observedIdle else {
+                bridge.emit(.inconsistentTerminal(value.generation)); continue
+            }
+            clearUtterance()
+            if bridge.completeShutdownAfterMatchedIdle() {
+                shouldExit = true // No second AV Stop; matched terminal+idle proves safe teardown.
+            } else if bridge.retireEnded(value.generation) { bridge.emit(.ended(value.generation)) }
+        }
+    }
+    func finish() {
+        assertOwner(); precondition(shouldExit && active == nil)
+        clearUtterance(); engine = nil
+    }
+}
