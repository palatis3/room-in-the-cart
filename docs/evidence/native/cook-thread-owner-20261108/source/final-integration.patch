+/// A façade can disappear before its async Stop returns. This handle owns no
+/// native object; deinit only revokes/enqueues Stop through the thread-safe bridge.
+final class CookSpeechLifetime: @unchecked Sendable {
+    private let lock = NSLock()
+    private let bridge: CookNativeBridge
+    private let generation: UUID
+    private var armed = true
+    fileprivate init(bridge: CookNativeBridge, generation: UUID) {
+        self.bridge = bridge; self.generation = generation
+    }
+    func disarm() { lock.lock(); armed = false; lock.unlock() }
+    deinit {
+        lock.lock(); let shouldCancel = armed; armed = false; lock.unlock()
+        if shouldCancel { _ = bridge.submit(generation, kind: .stop) }
+    }
+}
