+/// @unchecked covers only locked value mailbox / CF wakeup handles. It must never
+/// store a synthesizer, utterance, delegate or native-core reference.
+private final class CookNativeBridge: @unchecked Sendable {
+    private let lock = NSLock()
+    private let relay: CookNativeRelay
+    private var generation: UUID?
+    private var sequence: UInt64 = 0
+    private var revoked = false
+    private var shuttingDown = false
+    private var pending: [CookNativeCommand] = []
+    private var inFlight: CookNativeTicket?
+    private var terminals: [CookNativeTerminal] = []
+    private var expectedTerminal: CookNativeTerminal?
+    private var runLoop: CFRunLoop?
+    private var source: CFRunLoopSource?
+    init(relay: CookNativeRelay) { self.relay = relay }
+    func emit(_ event: CookNativeEvent) {
+        let relay = relay
+        DispatchQueue.main.async { relay.send(event) }
+    }
+    func currentGeneration() -> UUID? { lock.lock(); defer { lock.unlock() }; return generation }
+    func open(_ id: UUID) -> Bool {
+        lock.lock(); defer { lock.unlock() }
+        guard !shuttingDown, generation == nil, inFlight == nil, pending.isEmpty else { return false }
+        generation = id; revoked = false; return true
+    }
+    func submit(_ id: UUID, kind: CookNativeTicket.Kind, text: String? = nil,
+                voice: AVSpeechSynthesisVoice? = nil, startBefore: Date? = nil) -> CookNativeTicket? {
+        lock.lock()
+        guard !shuttingDown, generation == id, (!revoked || kind == .stop),
+              pending.count < 4 || kind == .stop else { lock.unlock(); return nil }
+        sequence += 1
+        let ticket = CookNativeTicket(generation: id, sequence: sequence, kind: kind)
+        if kind == .stop { revoked = true; pending.removeAll() }
+        pending.append(.init(ticket: ticket, text: text, startBefore: startBefore, voice: voice))
+        let wake = (runLoop, source); lock.unlock()
+        signal(wake); return ticket
+    }
+    func shutdown() {
+        lock.lock()
+        guard !shuttingDown else { lock.unlock(); return }
+        shuttingDown = true; revoked = true; sequence += 1
+        let ticket = CookNativeTicket(generation: generation ?? UUID(), sequence: sequence, kind: .shutdown)
+        pending = [.init(ticket: ticket, text: nil, startBefore: nil, voice: nil)]
+        let wake = (runLoop, source); lock.unlock(); signal(wake)
+    }
+    func publish(_ loop: CFRunLoop, _ source: CFRunLoopSource) {
+        lock.lock(); runLoop = loop; self.source = source; lock.unlock()
+        signal((loop, source)) // Work may have arrived before thread readiness.
+    }
+    func detachWakeHandles() {
+        lock.lock(); runLoop = nil; source = nil; lock.unlock()
+    }
+    private func signal(_ wake: (CFRunLoop?, CFRunLoopSource?)) {
+        if let source = wake.1 { CFRunLoopSourceSignal(source) }
+        if let loop = wake.0 { CFRunLoopWakeUp(loop) }
+    }
+    func signalPending() {
+        lock.lock(); let wake = (runLoop, source); lock.unlock(); signal(wake)
+    }
+    func registerTerminal(_ value: CookNativeTerminal) {
+        lock.lock(); defer { lock.unlock() }
+        precondition(generation == value.generation && expectedTerminal == nil)
+        expectedTerminal = value
+    }
+    func clearTerminalRegistration(_ value: CookNativeTerminal) {
+        lock.lock(); defer { lock.unlock() }
+        if expectedTerminal == value { expectedTerminal = nil; terminals.removeAll() }
+    }
+    func terminal(_ value: CookNativeTerminal) {
+        lock.lock()
+        // Delegate captures a generation, so an old callback/address reuse cannot
+        // bind to a new utterance. Only one utterance is admitted per generation.
+        guard generation == value.generation, expectedTerminal == value else { lock.unlock(); return }
+        // One registered utterance; duplicate matching callbacks coalesce. Wrong
+        // identities cannot consume queue capacity or evict a legitimate end.
+        if terminals.isEmpty { terminals.append(value) }
+        let wake = (runLoop, source); lock.unlock(); signal(wake)
+    }
+    func takeTerminals() -> [CookNativeTerminal] {
+        lock.lock(); defer { lock.unlock() }
+        let values = terminals; terminals.removeAll(); return values
+    }
+    func takeNext() -> CookNativeCommand? {
+        lock.lock(); defer { lock.unlock() }
+        guard inFlight == nil else { return nil }
+        while !pending.isEmpty {
+            let command = pending.removeFirst()
+            let isShutdown = command.ticket.kind == .shutdown
+            guard isShutdown || (command.ticket.generation == generation && (!revoked || command.ticket.kind == .stop)) else { continue }
+            inFlight = command.ticket; return command // Admission linearization point.
+        }
+        return nil
+    }
+    func returned(_ ticket: CookNativeTicket, succeeded: Bool) {
+        lock.lock(); defer { lock.unlock() }
+        precondition(inFlight == ticket)
+        inFlight = nil
+        if succeeded && (ticket.kind == .stop || ticket.kind == .shutdown) {
+            generation = nil; terminals.removeAll(); expectedTerminal = nil
+            // Shutdown may have arrived while an ordinary Stop was in flight.
+            // Its owner-thread teardown command must survive that Stop's retirement.
+            if ticket.kind == .shutdown { pending.removeAll() }
+            else { pending.removeAll { $0.ticket.kind != .shutdown } }
+        }
+    }
+    func completeShutdownAfterMatchedIdle() -> Bool {
+        lock.lock(); defer { lock.unlock() }
+        guard shuttingDown, inFlight == nil else { return false }
+        generation = nil; pending.removeAll(); terminals.removeAll(); expectedTerminal = nil
+        return true
+    }
+    func retireEnded(_ id: UUID) -> Bool {
+        lock.lock(); defer { lock.unlock() }
+        guard generation == id, inFlight == nil, !shuttingDown else { return false }
+        generation = nil; pending.removeAll(); terminals.removeAll(); expectedTerminal = nil; return true
+    }
+}
