+/// The token is immutable and privately owned. NotificationCenter removal is the
+/// only deinit action; no native speech object is created, accessed or released.
+final class CookSpeechRouteObservation: @unchecked Sendable {
+    private static let queue = DispatchQueue(label: "dev.roominthecart.cook-route-snapshot", qos: .userInitiated)
+    private let center: NotificationCenter
+    private let token: NSObjectProtocol
+    init(center: NotificationCenter = .default,
+         previousOutputs: @escaping @Sendable (Notification) -> Set<String>? = { @Sendable note in CookSpeechRouteObservation.decodePrevious(note) },
+         currentOutputs: @escaping @Sendable () -> Set<String>? = { @Sendable in CookSpeechRouteObservation.readCurrent() },
+         onStop: @escaping @MainActor @Sendable () -> Void) {
+        self.center = center
+        token = center.addObserver(forName: AVAudioSession.routeChangeNotification, object: nil, queue: nil) { note in
+            let reason = (note.userInfo?[AVAudioSessionRouteChangeReasonKey] as? NSNumber)?.uintValue
+            // Only value data crosses from NotificationCenter to our queue.
+            let previous = previousOutputs(note)
+            if reason != AVAudioSession.RouteChangeReason.categoryChange.rawValue &&
+               reason != AVAudioSession.RouteChangeReason.newDeviceAvailable.rawValue {
+                DispatchQueue.main.async { onStop() }; return
+            }
+            Self.queue.async {
+                let current = currentOutputs()
+                if CookSpeechRoutePolicy.shouldStop(reason: reason, previous: previous, current: current) {
+                    DispatchQueue.main.async { onStop() }
+                }
+            }
+        }
+    }
+    deinit { center.removeObserver(token) }
+    static func decodePrevious(_ note: Notification) -> Set<String>? {
+        guard let route = note.userInfo?[AVAudioSessionRouteChangePreviousRouteKey] as? AVAudioSessionRouteDescription else { return nil }
+        return Set(route.outputs.map { $0.portType.rawValue + ":" + $0.uid })
+    }
+    static func readCurrent() -> Set<String>? {
+        Set(AVAudioSession.sharedInstance().currentRoute.outputs.map { $0.portType.rawValue + ":" + $0.uid })
+    }
