+        await fulfillment(of: [finished], timeout: 3)
+        let records = control.snapshot()
+        XCTAssertEqual(records.filter { $0.name == "create" }.count, 1)
+        XCTAssertEqual(records.filter { $0.name == "destroy" }.count, 1)
