+/// No admitted utterance + both idle flags is a provable no-work Stop. Once
+/// speech was admitted, sampled idle flags alone cannot turn native false into true.
+struct CookSpeechStopPolicy {
+    static func stop(hasAdmittedUtterance: Bool, matchedTerminal: Bool = false, isSpeaking: Bool, isPaused: Bool,
+                     callNativeStop: () -> Bool) -> Bool {
+        if (!hasAdmittedUtterance || matchedTerminal) && !isSpeaking && !isPaused { return true }
+        return callNativeStop()
+    }
+}
