+struct CookSpeechRoutePolicy {
+    static func shouldStop(reason: UInt?, previous: Set<String>?, current: Set<String>?) -> Bool {
+        guard let reason, let value = AVAudioSession.RouteChangeReason(rawValue: reason) else { return true }
+        switch value {
+        case .oldDeviceUnavailable, .noSuitableRouteForCategory, .override, .wakeFromSleep, .routeConfigurationChange, .unknown:
+            return true
+        case .newDeviceAvailable, .categoryChange:
+            // Our own setCategory may notify without changing output. Never skip
+            // an unknown/empty snapshot or an actual changed output route.
+            guard let previous, let current, !previous.isEmpty, !current.isEmpty else { return true }
+            return previous != current
+        @unknown default: return true
+        }
+    }
+}
