+@MainActor final class ThreadCookSpeechOwner {
+    static let shared = ThreadCookSpeechOwner()
+    private let relay: CookNativeRelay
+    private let bridge: CookNativeBridge
+    private var thread: Thread?
+    private var sinks: [UUID: @MainActor @Sendable (CookNativeEvent) -> Void] = [:]
+    private var shutdownCompletions: [@MainActor @Sendable (Bool) -> Void] = []
+    private var shutdownResult: Bool?
+    private var closed = false
+    private var routeObservation: CookSpeechRouteObservation?
+    private var interruptionObservation: CookSpeechInterruptionObservation?
+    private convenience init() {
+        self.init(engineFactory: { CookAVSpeechEngine() }, observeAudioNotifications: true)
+    }
+    // Internal injection admits only a Sendable factory, never a prebuilt engine.
+    // Tests use the SAME thread, source, mailbox, core, lifetime and event routing.
+    init(engineFactory: @escaping @Sendable () -> any CookNativeEngine,
+         observeAudioNotifications: Bool = false,
+         notificationCenter: NotificationCenter = .default,
+         deliverEvent: @escaping @MainActor @Sendable (CookNativeEvent, @escaping @MainActor @Sendable () -> Void) -> Void = { _, deliver in deliver() }) {
+        let relay = CookNativeRelay(), bridge = CookNativeBridge(relay: relay)
+        self.relay = relay; self.bridge = bridge
+        relay.receive = { [weak self] event in
+            deliverEvent(event) { [weak self] in self?.received(event) }
+        }
+        let thread = Thread {
+            autoreleasepool {
+                let core = CookNativeCore(bridge: bridge, factory: engineFactory)
+                let loop = CFRunLoopGetCurrent()!
+                var context = CFRunLoopSourceContext(version: 0, info: Unmanaged.passUnretained(core).toOpaque(),
+                    retain: nil, release: nil, copyDescription: nil, equal: nil, hash: nil, schedule: nil, cancel: nil,
+                    perform: { raw in
+                        guard let raw else { return }
+                        Unmanaged<CookNativeCore>.fromOpaque(raw).takeUnretainedValue().drain()
+                    })
+                let source = CFRunLoopSourceCreate(nil, 0, &context)!
+                CFRunLoopAddSource(loop, source, .defaultMode)
+                bridge.publish(loop, source)
+                while !core.shouldExit {
+                    autoreleasepool { _ = CFRunLoopRunInMode(.defaultMode, 60, true) }
+                }
+                // Context is non-owning. Remove/invalidate before releasing core;
+                // CF handles copied by another thread cannot own/release native core.
+                bridge.detachWakeHandles()
+                CFRunLoopRemoveSource(loop, source, .defaultMode)
+                CFRunLoopSourceInvalidate(source)
+                core.finish()
+                withExtendedLifetime(core) {}
+            }
+            bridge.emit(.closed)
+        }
+        thread.name = "dev.roominthecart.cook-speech-owner"
+        thread.qualityOfService = .userInitiated
+        self.thread = thread
+        if observeAudioNotifications {
+            routeObservation = CookSpeechRouteObservation(center: notificationCenter) { [weak self] in
+                self?.invalidateLogicalPlayback()
+            }
+            interruptionObservation = CookSpeechInterruptionObservation(center: notificationCenter) { [weak self] in
+                self?.invalidateLogicalPlayback()
+            }
+        }
+        thread.start()
+    }
+    // Shared production service lives for the process. An injected owner can be
+    // released early; deinit only queues teardown, never joins or touches native objects.
+    deinit { bridge.shutdown() }
+    func reserve(_ generation: UUID, events: @escaping @MainActor @Sendable (CookNativeEvent) -> Void) -> Bool {
+        guard !closed, bridge.open(generation) else { return false }
+        sinks[generation] = events; return true
+    }
+    func lifetime(for generation: UUID) -> CookSpeechLifetime { CookSpeechLifetime(bridge: bridge, generation: generation) }
+    func start(_ generation: UUID, text: String, voice: AVSpeechSynthesisVoice?, startBefore: Date) -> CookNativeTicket? {
+        bridge.submit(generation, kind: .start, text: text, voice: voice, startBefore: startBefore)
+    }
+    func pause(_ generation: UUID) -> CookNativeTicket? { bridge.submit(generation, kind: .pause) }
+    func resume(_ generation: UUID) -> CookNativeTicket? { bridge.submit(generation, kind: .resume) }
+    func stop(_ generation: UUID) -> CookNativeTicket? { bridge.submit(generation, kind: .stop) }
+    /// Route close uses stop(generation), not service shutdown. The bounded shared
+    /// thread survives views; explicit service shutdown is asynchronous and final.
+    func shutdown(_ completion: @escaping @MainActor @Sendable (Bool) -> Void) {
+        if closed {
+            if let shutdownResult { completion(shutdownResult) }
+            else { shutdownCompletions.append(completion) }
+            return
+        }
+        closed = true; shutdownCompletions.append(completion)
+        // Cancel any explicit repeat before shutdown can acknowledge idle.
+        for (id, sink) in Array(sinks) { sink(.externalStop(id)) }
+        bridge.shutdown()
+    }
+    private func invalidateLogicalPlayback() {
+        // Native retirement precedes MainActor acknowledgment. Logical sinks still
+        // own pending repeat in that gap, so do not consult bridge.currentGeneration.
+        for (id, sink) in Array(sinks) { sink(.externalStop(id)) }
+    }
+    private func received(_ event: CookNativeEvent) {
+        switch event {
+        case .result(let ticket, let succeeded):
+            // A rejected native shutdown Stop leaves teardown pending. A later
+            // matching terminal+idle may finish it; all shutdown callers wait for
+            // .closed instead of receiving a false claim of completed teardown.
+            sinks[ticket.generation]?(event)
+            if ticket.kind == .stop && succeeded { sinks[ticket.generation] = nil }
+        case .ended(let id):
+            sinks[id]?(event); sinks[id] = nil
+        case .externalStop(let id): sinks[id]?(event)
+        case .inconsistentTerminal(let id): sinks[id]?(event)
+        case .closed:
+            for sink in Array(sinks.values) { sink(.closed) }
+            sinks.removeAll(); thread = nil; routeObservation = nil; interruptionObservation = nil
+            shutdownResult = true
+            let completions = shutdownCompletions; shutdownCompletions.removeAll()
+            completions.forEach { $0(true) }
+        }
+    }
+}
