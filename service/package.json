{
  "name": "@room-in-the-cart/service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.5 <23"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs src/billing/tests/*.test.mjs",
    "start": "node dist/main.js",
    "operations": "node dist/operations-cli.js",
    "test:operations": "npm run build && node scripts/test-operations.mjs",
    "migrate": "node scripts/migrate.mjs",
    "test:integration": "npm run build && node scripts/test-database.mjs",
    "test:guardian": "npm run build && node scripts/test-guardian.mjs"
  },
  "devDependencies": {
    "@types/node": "22.14.0",
    "@types/pg": "8.15.5",
    "typescript": "5.7.3"
  },
  "dependencies": {
    "@apple/app-store-server-library": "3.1.0",
    "jose": "6.2.15",
    "pg": "8.23.1",
    "zod": "4.6.7"
  }
}
