# Runtime must inherit ritc_app, be NON-SUPERUSER, NON-BYPASSRLS and not own tables.
DATABASE_URL=postgresql://ritc_runtime:replace-locally@127.0.0.1:55432/room_in_the_cart
# Remote TLS always verifies identity. For Supabase, supply the public root CA PEM
# downloaded from that project's Database Settings (see ../config/supabase-ca.crt).
DATABASE_CA_PEM=
# A separate owner connection is used ONLY by npm run migrate.
MIGRATION_DATABASE_URL=postgresql://migration_owner:replace-locally@127.0.0.1:55432/room_in_the_cart
JWT_ISSUER=https://uwjxrotnocxxomqdetzk.supabase.co/auth/v1
JWT_AUDIENCE=authenticated
JWT_JWKS_URL=https://uwjxrotnocxxomqdetzk.supabase.co/auth/v1/.well-known/jwks.json
WEB_ORIGIN=https://your-application.example
PORT=3001
# Remain disabled until actual guardian verification, notice and retention are approved/configured.
CHILD_NETWORK_ENABLED=false
CONSENT_NOTICE_VERSION=
# Use a managed TLS reverse proxy; container deployment may bind 0.0.0.0 explicitly.
HOST=127.0.0.1
