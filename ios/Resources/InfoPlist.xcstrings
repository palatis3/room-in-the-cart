{
  "sourceLanguage": "en",
  "strings": {
    "NSFaceIDUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Face ID to unlock your private shopping workspace."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Face ID para desbloquear tu espacio privado de compras."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate a shopping list or ask about your pantry on this iPhone. For online transcription, you can record, review and send a separate clip."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dicta una lista de compras o consulta tu despensa en este iPhone. Para una transcripción en línea, puedes grabar un audio aparte, revisarlo y enviarlo."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn your words into text on this iPhone so you can review a shopping list, pantry update or package question."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Convierte tus palabras en texto en este iPhone para que puedas revisar una lista de compras, un cambio en la despensa o una pregunta sobre un envase."
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan a package, recipe or receipt on this iPhone. You can choose to share a cropped image for online help."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanea un envase, una receta o un recibo en este iPhone. Puedes elegir compartir un recorte de la imagen para recibir ayuda en línea."
          }
        }
      }
    }
  },
  "version": "1.0"
}
