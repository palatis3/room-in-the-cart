{
  "sourceLanguage": "en",
  "strings": {
    "NSFaceIDUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Face ID to unlock your private shopping workspace."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Face ID para desbloquear tu espacio privado de compras."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the microphone to dictate grocery text for your review on this iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el micrófono para dictar texto de compras y revisarlo en este iPhone."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn dictated words into text on this iPhone so you can review them before adding anything."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Convierte las palabras dictadas en texto en este iPhone para revisarlas antes de agregar algo."
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the camera to review package, recipe or receipt photos on this iPhone. Photos are not uploaded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa la cámara para revisar fotos de productos, recetas o recibos en este iPhone. Las fotos no se suben a internet."
          }
        }
      }
    }
  },
  "version": "1.0"
}
