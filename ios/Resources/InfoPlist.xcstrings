{
  "sourceLanguage": "en",
  "strings": {
    "NSFaceIDUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Face ID to unlock your private shopping workspace."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Face ID para desbloquear tu espacio privado de compras."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate your list on this iPhone or record a separate clip to review and send for online transcription."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dicta tu lista en este iPhone o graba un audio aparte que puedes revisar y enviar para transcribirlo en línea."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn dictated words into text on this iPhone so you can review them before adding anything."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Convierte las palabras dictadas en texto en este iPhone para revisarlas antes de agregar algo."
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan a package, recipe or receipt on this iPhone. You can choose to share a cropped image for online help."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanea un envase, una receta o un recibo en este iPhone. Puedes elegir compartir un recorte de la imagen para recibir ayuda en línea."
          }
        }
      }
    }
  },
  "version": "1.0"
}
