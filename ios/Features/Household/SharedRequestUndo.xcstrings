    "Review every remaining whole pack. Unknown legacy food stays untracked even when a usable amount is entered.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review every remaining whole pack. Unknown legacy food stays untracked even when a usable amount is entered."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa todos los paquetes enteros restantes. Los alimentos anteriores desconocidos siguen sin seguimiento aunque se introduzca una cantidad utilizable."
          }
        }
      }
    },
    "The accepted link will be removed; no replacement link is created.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The accepted link will be removed; no replacement link is created."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminará el vínculo aceptado; no se creará otro en su lugar."
          }
        }
      }
    },
    "The quote terms stay unchanged. Removing or restoring items can still change the checkout total and fee.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The quote terms stay unchanged. Removing or restoring items can still change the checkout total and fee."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las condiciones del presupuesto se mantienen. Eliminar o restaurar artículos puede cambiar el total de compra y el cargo."
          }
        }
      }
    },
    "The request Undo is not confirmed. Check every remaining pack and review again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The request Undo is not confirmed. Check every remaining pack and review again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha confirmado que se deshiciera la solicitud. Comprueba todos los paquetes restantes y vuelve a revisar."
          }
        }
      }
    },
    "This acceptance cannot currently be undone. No historical facts were restored.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This acceptance cannot currently be undone. No historical facts were restored."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta aceptación no se puede deshacer ahora. No se han restaurado datos históricos."
          }
        }
      }
    },
    "This also reverses the complete initial food adoption, including its manual assertions, relationships and mappings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This also reverses the complete initial food adoption, including its manual assertions, relationships and mappings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto también revierte la configuración inicial completa de los alimentos, incluidas sus confirmaciones manuales, relaciones y correspondencias."
          }
        }
      }
    },
    "This pickup": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This pickup"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta recogida"
          }
        }
      }
    },
    "Undo restores the exact accepted request outcome and link together with its complete basket and food changes. Later unrelated facts remain.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Undo restores the exact accepted request outcome and link together with its complete basket and food changes. Later unrelated facts remain."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deshacer restaura el resultado exacto de la solicitud aceptada y su vínculo, junto con todos sus cambios de cesta y alimentos. Se conservan los datos posteriores no relacionados."
          }
        }
      }
    }
  },
  "version": "1.0"
}
