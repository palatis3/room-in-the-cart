{
  "sourceLanguage": "en",
  "strings": {
    "%@ · reference %@. This ends this enrollment's online reads, queued writes and web access. Other devices and household membership stay active.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · reference %@. This ends this enrollment's online reads, queued writes and web access. Other devices and household membership stay active."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · referencia %@. Esto termina las lecturas en línea, los cambios pendientes y el acceso web de este registro. Los otros dispositivos y la membresía del hogar siguen activos."
          }
        }
      }
    },
    "A person may have several enrollments on one phone or browser. Use the enrollment date and reference to choose the access to end.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A person may have several enrollments on one phone or browser. Use the enrollment date and reference to choose the access to end."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una persona puede tener varios registros en un teléfono o navegador. Usa la fecha y la referencia para elegir el acceso que deseas terminar."
          }
        }
      }
    },
    "A saved device action belongs to another account or household. Return to that account to reconcile it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A saved device action belongs to another account or household. Return to that account to reconcile it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una acción guardada de dispositivo pertenece a otra cuenta u hogar. Vuelve a esa cuenta para confirmar el resultado."
          }
        }
      }
    },
    "Access revoked": {
      "localizations": {
