    },
    "The result is not confirmed. Retry the same device action to confirm whether access ended.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The result is not confirmed. Retry the same device action to confirm whether access ended."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El resultado no está confirmado. Reintenta la misma acción para confirmar si terminó el acceso."
          }
        }
      }
    },
    "These devices are no longer available to this account. Refresh current access.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These devices are no longer available to this account. Refresh current access."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos dispositivos ya no están disponibles para esta cuenta. Actualiza el acceso actual."
          }
        }
      }
    },
    "This device. Use Sign out in household settings to end this enrollment.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device. Use Sign out in household settings to end this enrollment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo. Usa Cerrar sesión en los ajustes del hogar para terminar este registro."
