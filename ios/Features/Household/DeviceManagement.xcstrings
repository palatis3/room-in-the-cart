    },
    "Device access was revoked. Refresh devices to review current access.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device access was revoked. Refresh devices to review current access."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se revocó el acceso del dispositivo. Actualiza los dispositivos para revisar el acceso actual."
          }
        }
      }
    },
