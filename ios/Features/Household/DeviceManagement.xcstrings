    },
    "Devices could not be loaded or the action could not be saved. Try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Devices could not be loaded or the action could not be saved. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron cargar los dispositivos o guardar la acción. Inténtalo de nuevo."
