    },
    "Clearing a local retry does not cancel setup or withdraw permission already saved by the household service.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clearing a local retry does not cancel setup or withdraw permission already saved by the household service."
