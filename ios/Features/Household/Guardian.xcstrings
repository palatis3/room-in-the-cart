{
  "sourceLanguage": "en",
  "strings": {
    "Family permissions": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Family permissions"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permisos familiares"
          }
        }
      }
    },
    "Children and guardian permission": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Children and guardian permission"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Menores y permiso del tutor"
          }
        }
      }
    },
    "What a child can do": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What a child can do"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué puede hacer el menor"
          }
        }
      }
    },
    "With guardian permission, a child can send grocery requests and see the status of their own requests. The assigned shopper decides what goes in the basket. The household budget stays private.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With guardian permission, a child can send grocery requests and see the status of their own requests. The assigned shopper decides what goes in the basket. The household budget stays private."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con el permiso de su tutor, el menor puede pedir productos y ver el estado de sus propias solicitudes. La persona encargada de comprar decide qué agrega a la cesta. El presupuesto del hogar es privado."
          }
        }
      }
    },
    "On the guardian’s iPhone": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the guardian’s iPhone"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el iPhone del tutor"
          }
        }
      }
    },
    "When child setup is available, open Household requests in Settings, sign in to your adult account, choose your child’s household, then open Guardian controls.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When child setup is available, open Household requests in Settings, sign in to your adult account, choose your child’s household, then open Guardian controls."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando esté disponible la configuración para menores, abre Solicitudes del hogar en Configuración, inicia sesión con tu cuenta de adulto, elige el hogar del menor y abre Controles del tutor."
          }
        }
      }
    },
    "A parent or legal guardian verifies adulthood, gives permission and confirms the child’s device. Keep the invitation private. The child signs in with their own approved email.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A parent or legal guardian verifies adulthood, gives permission and confirms the child’s device. Keep the invitation private. The child signs in with their own approved email."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La madre, el padre o el tutor legal verifica su mayoría de edad, da permiso y confirma el dispositivo del menor. La invitación es privada. El menor inicia sesión con su propio correo aprobado."
          }
        }
      }
    },
    "Read the family guide online": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read the family guide online"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer la guía familiar en línea"
          }
        }
      }
    },
    "Online requests stay unavailable until your guardian finishes setup. An adult account cannot be used to sign in for a child.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Online requests stay unavailable until your guardian finishes setup. An adult account cannot be used to sign in for a child."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para enviar solicitudes en línea, el tutor debe terminar la configuración. El menor no puede iniciar sesión con la cuenta de un adulto."
          }
        }
      }
    },
    "Child access": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Child access"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acceso del menor"
          }
        }
      }
    },
    "Check your approved email and enter its sign-in code on this phone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your approved email and enter its sign-in code on this phone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa el correo que aprobó tu tutor e ingresa aquí el código de acceso."
          }
        }
      }
    },
    "Keep this setup": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep this setup"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservar esta configuración"
          }
        }
      }
    },
    "Child access is unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Child access is unavailable"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso infantil no está disponible"
          }
        }
      }
    },
    "Enter the invitation from your guardian and the email they approved for you.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the invitation from your guardian and the email they approved for you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingresa la invitación de tu tutor y el correo electrónico que aprobó para ti."
          }
        }
      }
    },
    "Look at the pairing code on the child’s phone. Enter it here, on your phone, to confirm that device.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look at the pairing code on the child’s phone. Enter it here, on your phone, to confirm that device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca el código de vinculación en el teléfono del menor. Ingrésalo aquí, en tu teléfono, para confirmar ese dispositivo."
          }
        }
      }
    },
    "Opening child space locks the private workspace on this iPhone. To return, choose “Leave child space”, confirm sign-out, then unlock the workspace.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opening child space locks the private workspace on this iPhone. To return, choose “Leave child space”, confirm sign-out, then unlock the workspace."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir el espacio del menor bloquea el espacio privado en este iPhone. Para volver, elige «Salir del espacio del menor», confirma el cierre de sesión y desbloquea el espacio privado."
          }
        }
      }
    },
    "Next shop only · ID %@ · created %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next shop only · ID %@ · created %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo la próxima compra · ID %1$@ · creada el %2$@"
          }
        }
      }
    },
    "This pickup · ID %@ · created %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This pickup · ID %@ · created %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta recogida · ID %1$@ · creada el %2$@"
          }
        }
      }
    },
    "On the child’s device": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the child’s device"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el dispositivo del menor"
          }
        }
      }
    },
    "On the guardian’s device": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the guardian’s device"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el dispositivo del tutor"
          }
        }
      }
    },
    "Send this invitation privately to the child’s device. The child will use the email you approved.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send this invitation privately to the child’s device. The child will use the email you approved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía esta invitación en privado al dispositivo del menor. El menor usará el correo electrónico que aprobaste."
          }
        }
      }
    },
    "Verify your adulthood, give permission for this child’s own requests, then confirm the child’s device.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verify your adulthood, give permission for this child’s own requests, then confirm the child’s device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica que eres mayor de edad, da permiso para que este menor envíe sus propias solicitudes y luego confirma su dispositivo."
          }
        }
      }
    },
    "You can send a request to the shopper. Only your own requests appear here.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can send a request to the shopper. Only your own requests appear here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes enviarle una solicitud a quien hace las compras. Aquí solo aparecen tus propias solicitudes."
          }
        }
      }
    },
    "You confirmed the child’s device. On that device, the child can now choose Finish child setup.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You confirmed the child’s device. On that device, the child can now choose Finish child setup."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmaste el dispositivo del menor. Ahora el menor puede seleccionar Terminar la configuración infantil en ese dispositivo."
          }
        }
      }
    },
    "Your guardian enters this pairing code on their own phone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your guardian enters this pairing code on their own phone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu tutor ingresa este código de vinculación en su propio teléfono."
          }
        }
      }
    },
    "Your guardian will confirm this phone before you can send a request.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your guardian will confirm this phone before you can send a request."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu tutor confirmará este teléfono antes de que puedas enviar una solicitud."
          }
        }
      }
    },
    "A child invitation requires the child's own live authenticated session from an approved guardian setup. This app cannot create or substitute an adult account for that session.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A child invitation requires the child's own live authenticated session from an approved guardian setup. This app cannot create or substitute an adult account for that session."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una invitación para un menor requiere su propia sesión autenticada activa, procedente de una configuración de tutor aprobada. Esta app no puede crear ni sustituir esa sesión por una cuenta de adulto."
          }
        }
      }
    },
    "A private review has already been requested. Refresh to see your cases.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A private review has already been requested. Refresh to see your cases."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya se ha solicitado una revisión privada. Actualiza la lista para ver tus casos."
          }
        }
      }
    },
    "A sign-in code was requested, but the child’s account has not been confirmed. Ask the review team to investigate the interrupted setup.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A sign-in code was requested, but the child’s account has not been confirmed. Ask the review team to investigate the interrupted setup."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se solicitó un código de acceso, pero la cuenta del menor no se ha confirmado. Pide al equipo de revisión que investigue la configuración interrumpida."
          }
        }
      }
    },
    "Additional guardian verification needed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Additional guardian verification needed"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se necesita una verificación adicional del tutor"
          }
        }
      }
    },
    "Adulthood verification is complete. Review the current notice and make a separate permission decision.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adulthood verification is complete. Review the current notice and make a separate permission decision."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La verificación de mayoría de edad está completa. Revisa el aviso actual y toma una decisión de permiso por separado."
          }
        }
      }
    },
    "Adulthood verification needed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adulthood verification needed"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se necesita verificar la mayoría de edad"
          }
        }
      }
    },
    "Adulthood verified; permission still needed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adulthood verified; permission still needed"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mayoría de edad verificada; aún se necesita permiso"
          }
        }
      }
    },
    "An exact action is saved on this device. Check its status before starting a different action.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An exact action is saved on this device. Check its status before starting a different action."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay una acción exacta guardada en este dispositivo. Consulta su estado antes de iniciar una acción diferente."
          }
        }
      }
    },
    "Ask your guardian to keep the invitation private and check setup status. Online requests stay unavailable until verification, permission, and device pairing are complete.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask your guardian to keep the invitation private and check setup status. Online requests stay unavailable until verification, permission, and device pairing are complete."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pide a tu tutor que mantenga la invitación privada y consulte la configuración. Las solicitudes en línea no están disponibles hasta completar la verificación, el permiso y la vinculación del dispositivo."
          }
        }
      }
    },
    "Ask your parent or legal guardian to open Household requests on their own device, choose your household, then open Guardian controls and Delete a child’s account. They can do this before you finish pairing your device.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask your parent or legal guardian to open Household requests on their own device, choose your household, then open Guardian controls and Delete a child’s account. They can do this before you finish pairing your device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pide a tu madre, padre o tutor legal que abra Solicitudes del hogar en su propio dispositivo, elija tu hogar y abra Controles del tutor y después Eliminar la cuenta de un menor. Puede hacerlo antes de que termines de vincular tu dispositivo."
          }
        }
      }
    },
    "Begin a new child setup": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Begin a new child setup"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciar una nueva configuración para un menor"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelar"
          }
        }
      }
    },
    "Cancel this child setup?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel this child setup?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cancelar esta configuración para el menor?"
          }
        }
      }
    },
    "Cancel this setup": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel this setup"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelar esta configuración"
          }
        }
      }
    },
    "Cancellation ends this pending setup. An active child's permission is withdrawn through current permissions.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancellation ends this pending setup. An active child's permission is withdrawn through current permissions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cancelación termina esta configuración pendiente. El permiso activo de un menor se retira desde los permisos actuales."
          }
        }
      }
    },
    "Case available until": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Case available until"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Caso disponible hasta"
          }
        }
      }
    },
    "Case number": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Case number"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Número de caso"
          }
        }
      }
    },
    "Check child access again": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check child access again"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volver a comprobar el acceso del menor"
          }
        }
      }
    },
    "Check current setup status": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check current setup status"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultar el estado actual de configuración"
          }
        }
      }
    },
    "Check guardian confirmation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check guardian confirmation"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultar la confirmación del tutor"
          }
        }
      }
    },
    "Check status, then clear local retry": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check status, then clear local retry"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultar el estado y borrar el reintento local"
          }
        }
      }
    },
    "Check the email approved by your guardian for the sign-in code. No adult account is used here.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the email approved by your guardian for the sign-in code. No adult account is used here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca el código de inicio de sesión en el correo electrónico aprobado por tu tutor. Aquí no se usa ninguna cuenta de adulto."
          }
        }
      }
    },
    "Checking child setup…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking child setup…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprobando la configuración para el menor…"
          }
        }
      }
    },
    "Checking guardian setup…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking guardian setup…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprobando la configuración del tutor…"
          }
        }
      }
    },
    "Child access could not be reopened. Adult work remains locked. You can remove this child session from the device.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Child access could not be reopened. Adult work remains locked. You can remove this child session from the device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo restablecer el acceso del menor. Las funciones de adulto siguen bloqueadas. Puedes eliminar esta sesión del menor del dispositivo."
          }
        }
      }
    },
    "Child access was removed from this device. Remote device revocation could not be confirmed; ask your guardian to review active permission.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Child access was removed from this device. Remote device revocation could not be confirmed; ask your guardian to review active permission."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminó el acceso del menor de este dispositivo. No se pudo confirmar la revocación remota del acceso de este dispositivo; pide a tu tutor que revise el permiso activo."
          }
        }
      }
    },
    "Child access was removed from this device. Remote sign-out could not be confirmed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Child access was removed from this device. Remote sign-out could not be confirmed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminó el acceso del menor de este dispositivo. No se pudo confirmar el cierre de sesión remoto."
          }
        }
      }
    },
    "Child account deletion receipt": {
