    "Children can send and see only their own requests. Verification of adulthood, guardian permission, and device confirmation are separate steps.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Children can send and see only their own requests. Verification of adulthood, guardian permission, and device confirmation are separate steps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los menores solo pueden enviar y ver sus propias solicitudes. La verificación de mayoría de edad, el permiso del tutor y la confirmación del dispositivo son pasos separados."
          }
        }
      }
    },
    "Clear this local retry?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
