{
  "sourceLanguage": "en",
  "strings": {
    "A child invitation requires the child's own live authenticated session from an approved guardian setup. This app cannot create or substitute an adult account for that session.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A child invitation requires the child's own live authenticated session from an approved guardian setup. This app cannot create or substitute an adult account for that session."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una invitación para un menor requiere su propia sesión autenticada activa, procedente de una configuración de tutor aprobada. Esta app no puede crear ni sustituir esa sesión por una cuenta de adulto."
          }
        }
      }
    },
    "Adulthood verification is complete. Review the current notice and make a separate permission decision.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adulthood verification is complete. Review the current notice and make a separate permission decision."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La verificación de mayoría de edad está completa. Revisa el aviso actual y toma una decisión de permiso por separado."
          }
        }
      }
    },
    "Adulthood verification needed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adulthood verification needed"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se necesita verificar la mayoría de edad"
          }
        }
      }
    },
    "Adulthood verified; permission still needed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adulthood verified; permission still needed"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mayoría de edad verificada; aún se necesita permiso"
          }
        }
      }
    },
    "An exact action is saved on this device. Check its status before starting a different action.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An exact action is saved on this device. Check its status before starting a different action."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay una acción exacta guardada en este dispositivo. Consulta su estado antes de iniciar una acción diferente."
          }
        }
      }
    },
    "Ask your guardian to keep the invitation private and check setup status. Online requests stay unavailable until verification, permission, and device pairing are complete.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask your guardian to keep the invitation private and check setup status. Online requests stay unavailable until verification, permission, and device pairing are complete."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pide a tu tutor que mantenga la invitación privada y consulte la configuración. Las solicitudes en línea no están disponibles hasta completar la verificación, el permiso y la vinculación del dispositivo."
          }
        }
      }
    },
    "Begin a new child setup": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Begin a new child setup"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciar una nueva configuración para un menor"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelar"
          }
        }
      }
    },
    "Cancel this child setup?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel this child setup?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cancelar esta configuración para el menor?"
          }
        }
      }
    },
    "Cancel this setup": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel this setup"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelar esta configuración"
          }
        }
      }
    },
    "Cancellation ends this pending setup. An active child's permission is withdrawn through current permissions.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancellation ends this pending setup. An active child's permission is withdrawn through current permissions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cancelación termina esta configuración pendiente. El permiso activo de un menor se retira desde los permisos actuales."
          }
        }
      }
    },
    "Check child access again": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check child access again"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volver a comprobar el acceso del menor"
          }
        }
      }
    },
    "Check current setup status": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check current setup status"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultar el estado actual de configuración"
          }
        }
      }
    },
    "Check guardian confirmation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check guardian confirmation"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultar la confirmación del tutor"
          }
        }
      }
    },
    "Check status, then clear local retry": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check status, then clear local retry"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultar el estado y borrar el reintento local"
          }
        }
      }
    },
    "Check the email approved by your guardian for the sign-in code. No adult account is used here.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the email approved by your guardian for the sign-in code. No adult account is used here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca el código de inicio de sesión en el correo electrónico aprobado por tu tutor. Aquí no se usa ninguna cuenta de adulto."
          }
        }
      }
    },
    "Checking child setup…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking child setup…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprobando la configuración para el menor…"
          }
        }
      }
    },
    "Checking guardian setup…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking guardian setup…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprobando la configuración del tutor…"
          }
        }
      }
    },
    "Child access could not be reopened. Adult work remains locked. You can remove this child session from the device.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Child access could not be reopened. Adult work remains locked. You can remove this child session from the device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo restablecer el acceso del menor. Las funciones de adulto siguen bloqueadas. Puedes eliminar esta sesión del menor del dispositivo."
          }
        }
      }
    },
    "Child access was removed from this device. Remote device revocation could not be confirmed; ask your guardian to review active permission.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Child access was removed from this device. Remote device revocation could not be confirmed; ask your guardian to review active permission."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminó el acceso del menor de este dispositivo. No se pudo confirmar la revocación remota del acceso de este dispositivo; pide a tu tutor que revise el permiso activo."
          }
        }
      }
    },
    "Child access was removed from this device. Remote sign-out could not be confirmed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Child access was removed from this device. Remote sign-out could not be confirmed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminó el acceso del menor de este dispositivo. No se pudo confirmar el cierre de sesión remoto."
          }
        }
      }
    },
    "Child cleanup could not be confirmed. Adult work remains locked. Unlock this device and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Child cleanup could not be confirmed. Adult work remains locked. Unlock this device and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo confirmar la eliminación de los datos de sesión del menor. Las funciones de adulto siguen bloqueadas. Desbloquea este dispositivo e inténtalo de nuevo."
          }
        }
      }
    },
    "Child device confirmed; finish on that device": {
      "localizations": {
