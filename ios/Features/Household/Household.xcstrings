          }
        }
      }
    },
    "Your membership in %@ will end and the reviewed choices will apply.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your membership in %@ will end and the reviewed choices will apply."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu membresía en %@ terminará y se aplicarán las decisiones que revisaste."
          }
        }
      }
    },
    "Your private Records stay on this phone. Copies you already shared stay with their recipients. Other members keep their own records.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your private Records stay on this phone. Copies you already shared stay with their recipients. Other members keep their own records."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus registros privados se conservan en este teléfono. Quienes ya recibieron copias tuyas las conservan. Los demás miembros conservan sus propios registros."
          }
        }
      }
    },
    "Your private work stays on this phone. Signing in does not upload it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your private work stays on this phone. Signing in does not upload it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu trabajo privado permanece en este teléfono. Iniciar sesión no lo carga al servicio."
          }
        }
      }
    },
    "Your request has not been sent. Unlock this phone so it can save a deletion receipt, then try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your request has not been sent. Unlock this phone so it can save a deletion receipt, then try again."
