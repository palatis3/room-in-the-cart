          "stringUnit": {
            "state": "translated",
            "value": "You cannot undo an accepted request. The service will apply the household choices you reviewed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una vez aceptada la solicitud, no podrás deshacerla. El servicio aplicará las decisiones que revisaste para cada hogar."
          }
        }
      }
    },
    "You left the household. Its access is closed. The remaining memberships could not be refreshed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You left the household. Its access is closed. The remaining memberships could not be refreshed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has salido del hogar y tu acceso ha terminado. No se pudieron actualizar las demás membresías."
          }
        }
      }
    },
    "You left the household. Some local household retries could not be cleared.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You left the household. Some local household retries could not be cleared."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has salido del hogar. No se pudieron borrar algunas acciones de ese hogar que estaban pendientes de reintento en este teléfono."
          }
        }
      }
    },
    "You left this household. Unlock this phone to clear the saved request.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You left this household. Unlock this phone to clear the saved request."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has salido de este hogar. Desbloquea el teléfono para borrar la solicitud guardada."
          }
        }
      }
    },
    "You left this household. Your account is still active.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You left this household. Your account is still active."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has salido de este hogar. Tu cuenta sigue activa."
          }
        }
      }
    },
    "Your household access is still protected. Try unlocking this iPhone again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your household access is still protected. Try unlocking this iPhone again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso a tu hogar sigue protegido. Vuelve a intentar desbloquear este iPhone."
          }
        }
      }
    },
    "Your household alias": {
      "localizations": {
