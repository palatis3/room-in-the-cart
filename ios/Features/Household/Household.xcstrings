          "stringUnit": {
            "state": "translated",
            "value": "You left the household. Its access is closed. The remaining memberships could not be refreshed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has salido del hogar y tu acceso ha terminado. No se pudieron actualizar las demás membresías."
          }
        }
      }
    },
    "You left the household. Some local household retries could not be cleared.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You left the household. Some local household retries could not be cleared."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has salido del hogar. No se pudieron borrar algunas acciones de ese hogar que estaban pendientes de reintento en este teléfono."
          }
        }
      }
    },
    "Your private Records stay on this phone. Copies you already shared stay with their recipients. Other members keep their own records.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your private Records stay on this phone. Copies you already shared stay with their recipients. Other members keep their own records."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus registros privados se conservan en este teléfono. Quienes ya recibieron copias tuyas las conservan. Los demás miembros conservan sus propios registros."
          }
        }
      }
    },
