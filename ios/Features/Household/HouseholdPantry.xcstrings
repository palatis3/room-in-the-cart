{
  "sourceLanguage": "en",
  "strings": {
    "Adults with pantry access can see stored food, add food and correct counts.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adults with pantry access can see stored food, add food and correct counts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los adultos con acceso a la despensa pueden ver y añadir alimentos y corregir cantidades."
          }
        }
      }
    },
    "An earlier retry ended when pantry access changed. Check the current stock.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An earlier retry ended when pantry access changed. Check the current stock."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reintento anterior dejó de estar disponible al cambiar el acceso a la despensa. Revisa las existencias actuales."
          }
        }
      }
    },
    "Check the count and unit.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the count and unit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa la cantidad y la unidad."
          }
        }
      }
    },
