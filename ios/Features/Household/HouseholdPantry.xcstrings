{
  "sourceLanguage": "en",
  "strings": {
    "Adults with pantry access can see stored food and add food for the household.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adults with pantry access can see stored food and add food for the household."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los adultos con acceso a la despensa pueden ver los alimentos guardados y añadir alimentos para el hogar."
          }
        }
      }
    },
    "An earlier retry ended when pantry access changed. Check the stock before adding food.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An earlier retry ended when pantry access changed. Check the stock before adding food."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reintento anterior terminó al cambiar el acceso a la despensa. Revisa las existencias antes de añadir alimentos."
          }
        }
      }
    },
    "Check the food name, amount and exclusions.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the food name, amount and exclusions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba el nombre, la cantidad y las exclusiones del alimento."
          }
        }
      }
    },
    "Check the stock below. Retrying sends the same addition.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the stock below. Retrying sends the same addition."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa las existencias que aparecen abajo. Al reintentar, se vuelve a enviar el mismo registro."
          }
        }
      }
    },
