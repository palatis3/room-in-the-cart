{
  "sourceLanguage": "en",
  "strings": {
    "This copy could not be matched to the saved receipt. Check the household stock. For a missed item, try the original file. If it still cannot be matched, choose Add food to storage.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This copy could not be matched to the saved receipt. Check the household stock. For a missed item, try the original file. If it still cannot be matched, choose Add food to storage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo asociar esta copia con el recibo guardado. Revisa las existencias del hogar. Si falta un artículo, prueba con el archivo original. Si tampoco se puede asociar, elige «Registrar alimentos guardados»."
          }
        }
      }
    },
    "To help prevent counting a receipt twice, the app also sends a code based on all the lines it read, in order, including skipped lines.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To help prevent counting a receipt twice, the app also sends a code based on all the lines it read, in order, including skipped lines."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para evitar contar un recibo dos veces, la app también envía un código basado en todos los renglones que leyó, en orden, incluidos los omitidos."
          }
        }
      }
    },
    "%lld purchase days, usually %lld days apart.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld purchase days, usually %lld days apart."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld días de compra, normalmente con %lld días entre ellos."
          }
        }
      }
    },
    "%lld reviewed purchases": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld reviewed purchases"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld compras revisadas"
          }
        }
      }
    },
    "1 reviewed purchase": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1 reviewed purchase"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1 compra revisada"
          }
        }
      }
    },
    "Add receipt to household pantry": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add receipt to household pantry"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadir recibo a la despensa del hogar"
          }
        }
      }
    },
    "Adults with pantry access can see stored food, add food and correct counts.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adults with pantry access can see stored food, add food and correct counts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los adultos con acceso a la despensa pueden ver y añadir alimentos y corregir cantidades."
          }
        }
      }
    },
    "Adults with pantry access can see the store, date, any receipt reference you enter and the selected food lines, including original wording, quantities, storage location and any prices you enter. The original file stays on this device.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adults with pantry access can see the store, date, any receipt reference you enter and the selected food lines, including original wording, quantities, storage location and any prices you enter. The original file stays on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los adultos con acceso a la despensa pueden ver la tienda, la fecha, la referencia del recibo que ingreses y los renglones de alimentos seleccionados, con el texto original, las cantidades, el lugar de almacenamiento y los precios que ingreses. El archivo original se queda en este dispositivo."
          }
        }
      }
    },
    "An earlier retry ended when pantry access changed. Check the current stock.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An earlier retry ended when pantry access changed. Check the current stock."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reintento anterior dejó de estar disponible al cambiar el acceso a la despensa. Revisa las existencias actuales."
          }
        }
      }
    },
