    },
    "Granting access shares this shop's budget and allows private comparisons and proposals. It does not grant meal planning, household administration, a paid seat, or shopper authority.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Granting access shares this shop's budget and allows private comparisons and proposals. It does not grant meal planning, household administration, a paid seat, or shopper authority."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dar acceso comparte el presupuesto de esta compra y permite comparaciones y propuestas privadas. No otorga planificación de comidas, administración del hogar, una plaza de pago ni autoridad para comprar."
          }
        }
      }
    },
    "I reviewed these exact quotes, conditions, and shared commitments": {
      "localizations": {
        "en": {
