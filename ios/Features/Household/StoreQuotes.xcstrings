    "Adopting revises the open shared draft and clears former store prices and checkout charges. It preserves the original quote proof and requires fresh checkout review.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adopting revises the open shared draft and clears former store prices and checkout charges. It preserves the original quote proof and requires fresh checkout review."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Adoptar revisa el borrador compartido abierto y borra los precios y cargos anteriores. Conserva la evidencia original y requiere una nueva revisión del total de compra."
          }
        }
      }
    },
