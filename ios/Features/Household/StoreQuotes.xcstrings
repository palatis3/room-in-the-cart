    "Clearing cannot undo a comparison, proposal, grant, or store adoption already received. Review the refreshed household result.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clearing cannot undo a comparison, proposal, grant, or store adoption already received. Review the refreshed household result."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borrar no deshace una comparación, propuesta, permiso o adopción de tienda ya recibida. Revisa el resultado actualizado del hogar."
          }
        }
      }
    },
    "Comparison saved privately for you. Proposing is a separate action.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparison saved privately for you. Proposing is a separate action."
