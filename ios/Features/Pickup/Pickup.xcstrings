{
  "sourceLanguage": "en",
  "strings": {
    "A credit does not add food or repair a meal. A credit already included in a net charge is not subtracted again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A credit does not add food or repair a meal. A credit already included in a net charge is not subtracted again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un crédito no añade comida ni resuelve una comida pendiente. Un crédito ya incluido en un cargo neto no se vuelve a restar."
          }
        }
      }
    },
    "A line ceiling does not establish that the whole checkout fits. Review combined charges separately.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A line ceiling does not establish that the whole checkout fits. Review combined charges separately."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El límite de un producto no garantiza que alcance para toda la compra. Revisa los cargos combinados por separado."
          }
        }
      }
    },
    "A sent version does not prove receipt or acknowledgment. Cancelling share does not mark it sent.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A sent version does not prove receipt or acknowledgment. Cancelling share does not mark it sent."
