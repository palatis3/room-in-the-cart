    "Review a whole dinner replacement. The purchased basket, receipts and charges stay as recorded. Shared meal recovery is not available here.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review a whole dinner replacement. The purchased basket, receipts and charges stay as recorded. Shared meal recovery is not available here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa el reemplazo de toda una cena. La cesta comprada, los registros de llegada y los cargos se conservan tal como se guardaron. La recuperación de comidas compartidas no está disponible aquí."
          }
        }
      }
    },
