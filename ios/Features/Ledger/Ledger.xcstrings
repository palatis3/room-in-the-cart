  "strings": {
    "A dinner-only cap does not cover the whole pickup. Missing prices and fees remain unknown.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A dinner-only cap does not cover the whole pickup. Missing prices and fees remain unknown."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un límite solo para cenas no cubre toda la compra. Los precios y cargos faltantes siguen sin conocerse."
          }
        }
      }
    },
    "A matching item is already listed. Is this the same need or an additional amount?": {
      "localizations": {
