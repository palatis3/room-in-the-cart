    "No recorded result was found for this exact report. Its original evidence remains saved. If its sending window expired, review that evidence with the current shopper.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No recorded result was found for this exact report. Its original evidence remains saved. If its sending window expired, review that evidence with the current shopper."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró un resultado registrado para este reporte exacto. Sus registros originales siguen guardados. Si venció el plazo de envío, revísalos con el responsable actual."
          }
        }
