    "If the retry window expires, a missing receipt is not proof that placement failed. Check the original report status before deciding what happened.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the retry window expires, a missing receipt is not proof that placement failed. Check the original report status before deciding what happened."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vence el plazo de reintento, la falta de un comprobante no demuestra que el pedido falló. Verifica el estado del reporte original antes de decidir qué ocurrió."
          }
        }
      }
    },
