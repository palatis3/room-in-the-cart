    "A current status and the original action receipt are different evidence. A handled report is not sent again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A current status and the original action receipt are different evidence. A handled report is not sent again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El estado actual y el comprobante de la acción original son registros distintos. Un reporte ya atendido no se vuelve a enviar."
          }
        }
      }
    },
