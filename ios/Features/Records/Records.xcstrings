          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo las referencias de origen que selecciones se incluyen en la recuperación cifrada. Las copias legibles y para ayudantes no incluyen archivos adjuntos. Ningún archivo se sube automáticamente. Las copias compartidas no se pueden retirar."
          }
        }
      }
