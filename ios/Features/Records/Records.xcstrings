    "A recovery file restores selected private records, saved history and the source references you choose below as separate copies. It excludes raw voice, credentials, membership, consent and live permissions.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A recovery file restores selected private records, saved history and the source references you choose below as separate copies. It excludes raw voice, credentials, membership, consent and live permissions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un archivo de recuperación restaura los registros privados seleccionados, su historial y las referencias de origen que elijas abajo como copias separadas. Excluye grabaciones de voz, credenciales, membresía, consentimiento y permisos vigentes."
          }
        }
      }
    },
