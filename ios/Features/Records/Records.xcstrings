    "A previously confirmed ledger deletion is pending. Open Data and recovery to retry it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A previously confirmed ledger deletion is pending. Open Data and recovery to retry it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay una eliminación del registro confirmada anteriormente pendiente. Abre Datos y recuperación para reintentarlo."
          }
        }
      }
    },
    "A recovery file includes selected private records and their saved history. It excludes photos, voice, credentials, membership, consent and live permissions.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A recovery file includes selected private records and their saved history. It excludes photos, voice, credentials, membership, consent and live permissions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un archivo de recuperación incluye los registros privados seleccionados y su historial guardado. Excluye fotos, voz, credenciales, membresía, consentimiento y permisos activos."
          }
        }
      }
    },
    "A shop backup includes its linked dinner evidence and quote history. Reusable dinners, rotations and saved ideas are a separate library selection. Imported planning never restores paid access or permissions.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A shop backup includes its linked dinner evidence and quote history. Reusable dinners, rotations and saved ideas are a separate library selection. Imported planning never restores paid access or permissions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una copia de seguridad de una compra incluye sus datos de cenas vinculadas y su historial de cotizaciones. Las cenas reutilizables, rotaciones e ideas guardadas se seleccionan como biblioteca aparte. La planificación importada nunca restaura el acceso de pago ni los permisos."
          }
        }
      }
    },
