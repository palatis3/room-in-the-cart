    },
    "Only explicitly selected source references are included in encrypted recovery. Readable and helper copies contain no attachment bytes. No file is uploaded automatically. Shared copies cannot be recalled.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
