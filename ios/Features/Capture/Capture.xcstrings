    "Stop recording and review": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop recording and review"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detener la grabación y revisar"
          }
        }
