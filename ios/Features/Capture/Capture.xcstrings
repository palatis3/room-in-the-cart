          "stringUnit": {
            "state": "translated",
            "value": "Destination wording does not change where this request goes. Confirm the displayed household destination, or cancel and open the intended household."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto del destino no cambia adónde va esta solicitud. Confirma el destino del hogar que se muestra, o cancela y abre el hogar deseado."
          }
        }
      }
    },
    "This household or request changed. Close capture and review the current request.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This household or request changed. Close capture and review the current request."
          }
        },
