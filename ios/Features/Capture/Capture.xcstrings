    "Dictate on this iPhone": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate on this iPhone"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictar en este iPhone"
          }
        }
      }
    },
    "Listening — tap Stop when finished": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Listening — tap Stop when finished"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escuchando: toca Detener cuando termines"
          }
        }
      }
    },
    "Preparing text for review…": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparing text for review…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparando el texto para revisarlo…"
          }
        }
      }
    },
    "Recording stops after 45 seconds. Raw audio is not saved. Unsupported speech languages keep the typed path available.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording stops after 45 seconds. Raw audio is not saved. Unsupported speech languages keep the typed path available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La grabación se detiene a los 45 segundos. No se guarda el audio. Si el idioma de voz no es compatible, puedes escribir."
          }
        }
      }
    },
    "I checked the wording, amounts, units and exclusions.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I checked the wording, amounts, units and exclusions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisé el texto, las cantidades, las unidades y las exclusiones."
          }
        }
      }
    },
    "Continue to list review": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue to list review"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuar a la revisión de la lista"
          }
        }
      }
    },
    "The next screen reviews parsed quantities and duplicates. Captured text does not verify a price, a safe ingredient, a paid receipt or what arrived.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The next screen reviews parsed quantities and duplicates. Captured text does not verify a price, a safe ingredient, a paid receipt or what arrived."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la siguiente pantalla revisarás las cantidades interpretadas y los duplicados. El texto capturado no verifica precios, la seguridad de un ingrediente, el pago de un recibo ni lo que llegó."
          }
        }
      }
    },
    "Capture a list": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture a list"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Capturar una lista"
          }
        }
      }
    },
    "Cancel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelar"
          }
        }
      }
    },
    "Selected source photo. Recognized wording is shown below.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selected source photo. Recognized wording is shown below."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto de origen seleccionada. El texto reconocido aparece debajo."
          }
        }
      }
    },
    "No words recognized yet": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No words recognized yet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no se reconocieron palabras"
          }
        }
      }
    },
    "Some wording was uncertain. Compare it with the source and correct it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some wording was uncertain. Compare it with the source and correct it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parte del texto es incierta. Compáralo con el original y corrígelo."
          }
        }
      }
    },
    "Speech is not available in this build. Type or paste your list instead.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speech is not available in this build. Type or paste your list instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La voz no está disponible en esta versión. Escribe o pega tu lista."
          }
        }
      }
    },
    "Microphone or speech permission was not granted. Your typed draft is unchanged; typing, paste and photo review remain available.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Microphone or speech permission was not granted. Your typed draft is unchanged; typing, paste and photo review remain available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se concedió permiso para el micrófono o la voz. Tu borrador escrito no cambió; puedes escribir, pegar o revisar una foto."
          }
        }
      }
    },
    "On-device recognition is unavailable for this language or device. Type or paste instead; there is no online speech fallback.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On-device recognition is unavailable for this language or device. Type or paste instead; there is no online speech fallback."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reconocimiento en el dispositivo no está disponible para este idioma o dispositivo. Escribe o pega el texto; no se usa reconocimiento de voz por internet."
          }
        }
      }
    },
    "The microphone is unavailable. Stop another recording or type your list.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The microphone is unavailable. Stop another recording or type your list."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El micrófono no está disponible. Detén otra grabación o escribe tu lista."
          }
        }
      }
    },
    "Recognition could not finish. Review any captured wording or keep typing. Your saved pickup is unchanged.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recognition could not finish. Review any captured wording or keep typing. Your saved pickup is unchanged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reconocimiento no pudo terminar. Revisa el texto capturado o sigue escribiendo. Tu compra guardada no cambió."
          }
        }
      }
    },
    "This photo could not be read. Choose another image or type the text.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This photo could not be read. Choose another image or type the text."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer esta foto. Elige otra imagen o escribe el texto."
          }
        }
      }
    },
    "Use at most 200 lines and 20,000 characters, or choose a photo under 12 MB and 30 megapixels.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use at most 200 lines and 20,000 characters, or choose a photo under 12 MB and 30 megapixels."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa como máximo 200 líneas y 20 000 caracteres, o elige una foto de menos de 12 MB y 30 megapíxeles."
          }
        }
      }
    },
    "No readable text was found. Choose a clearer photo or type the text.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No readable text was found. Choose a clearer photo or type the text."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró texto legible. Elige una foto más clara o escribe el texto."
          }
        }
      }
    },
    "Current dated cook instruction": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current dated cook instruction"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instrucción de cocina actual con fecha"
          }
        }
      }
    },
    "VoiceOver can read this instruction. Separate playback is stopped.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceOver can read this instruction. Separate playback is stopped."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceOver puede leer esta instrucción. La reproducción independiente está detenida."
          }
        }
      }
    },
    "Pause readback": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause readback"
          }
