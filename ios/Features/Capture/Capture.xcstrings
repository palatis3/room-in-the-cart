          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer desde el principio"
          }
        }
      }
    },
    "Stop readback": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop readback"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detener la lectura"
          }
        }
      }
    },
    "A local voice is unavailable. The complete instruction remains readable.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A local voice is unavailable. The complete instruction remains readable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay una voz local disponible. Puedes seguir leyendo la instrucción completa."
          }
        }
      }
    },
    "Prepare the current instruction without private budget details before playback.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepare the current instruction without private budget details before playback."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepara la instrucción actual sin detalles privados del presupuesto antes de reproducirla."
