        }
      }
    },
    "Saved references stay on this device until removed or their saved pickup or grocery workspace is deleted. You can choose references separately for an encrypted recovery file in Records.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved references stay on this device until removed or their saved pickup or grocery workspace is deleted. You can choose references separately for an encrypted recovery file in Records."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las referencias guardadas permanecen en este dispositivo hasta que se eliminen o se borre su recogida o espacio de compras. Puedes elegir referencias por separado para un archivo de recuperación cifrado en Registros."
          }
        }
      }
    },
    "The original source stays with this recipe. Saved photos stay on this device unless you choose them for an encrypted recovery file in Records.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original source stays with this recipe. Saved photos stay on this device unless you choose them for an encrypted recovery file in Records."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El origen original permanece con esta receta. Las fotos guardadas permanecen en este dispositivo a menos que las elijas para un archivo de recuperación cifrado en Registros."
          }
        }
      }
    },
    "The source photo is local evidence. Encrypted recovery includes it only when you select it in Records.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The source photo is local evidence. Encrypted recovery includes it only when you select it in Records."
