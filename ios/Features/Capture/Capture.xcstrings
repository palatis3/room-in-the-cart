{
  "sourceLanguage": "en",
  "strings": {
    "Capture is optional. You can always type your list.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture is optional. You can always type your list."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La captura es opcional. Siempre puedes escribir tu lista."
          }
        }
      }
    },
    "Speech and photo text recognition run on this iPhone. Nothing is added until you review the list.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speech and photo text recognition run on this iPhone. Nothing is added until you review the list."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reconocimiento de voz y de texto en fotos se realiza en este iPhone. No se añade nada hasta que revises la lista."
          }
        }
      }
    },
    "Destination: this pickup’s list review": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Destination: this pickup’s list review"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Destino: revisión de la lista de esta compra"
          }
        }
      }
    },
    "Captured wording — check before using": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Captured wording — check before using"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Texto capturado: revísalo antes de usarlo"
          }
        }
      }
    },
    "Use captured text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use captured text"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar el texto capturado"
          }
        }
      }
    },
    "Keep my typed draft": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep my typed draft"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservar mi borrador escrito"
          }
        }
      }
    },
    "Your editable list": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your editable list"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu lista editable"
          }
        }
      }
    },
    "One item per line. Check item names, amounts, units and any exclusions.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One item per line. Check item names, amounts, units and any exclusions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un artículo por línea. Revisa los nombres, las cantidades, las unidades y las exclusiones."
          }
        }
      }
    },
    "List text to review": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "List text to review"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Texto de la lista para revisar"
          }
        }
      }
    },
    "Compare with the original": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare with the original"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparar con el original"
          }
        }
      }
    },
    "This wording may exclude an item. Check the exclusion before continuing.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This wording may exclude an item. Check the exclusion before continuing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este texto podría excluir un artículo. Revisa la exclusión antes de continuar."
          }
