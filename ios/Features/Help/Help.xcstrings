    "Start with a pack comparison. No account or connection is needed for your private shopping tools.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with a pack comparison. No account or connection is needed for your private shopping tools."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza con una comparación de paquetes. No necesitas una cuenta ni conexión para usar tus herramientas privadas de compra."
          }
        }
      }
    },
    "Using Room in the Cart": {
      "extractionState": "manual",
      "localizations": {
