    },
    "Online support is unavailable. You can read the help articles here or share your support summary.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Online support is unavailable. You can read the help articles here or share your support summary."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El soporte en línea no está disponible. Aquí puedes consultar los artículos de ayuda o compartir tu resumen de soporte."
          }
        }
      }
    },
    "Read offline help": {
      "extractionState": "manual",
      "localizations": {
