            "value": "Build a list and check the budget"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crear una lista y revisar el presupuesto"
          }
        }
      }
    },
    "Plan dinners and protect lunches": {
      "extractionState": "manual",
      "localizations": {
