    "Current access and saved status will be checked first. Clearing a retry does not undo a write already received. Exact retry is the way to recover the original receipt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current access and saved status will be checked first. Clearing a retry does not undo a write already received. Exact retry is the way to recover the original receipt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero se verificarán el acceso actual y el estado guardado. Borrar un reintento no deshace un registro ya recibido. El reintento exacto permite recuperar el comprobante original."
          }
        }
      }
    },
    "Current access is checked again. Do not start a replacement action while this result is uncertain.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current access is checked again. Do not start a replacement action while this result is uncertain."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se vuelve a verificar el acceso actual. No inicies una acción de reemplazo mientras este resultado sea incierto."
          }
        }
      }
    },
    "Current entered evidence reconciled": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current entered evidence reconciled"
