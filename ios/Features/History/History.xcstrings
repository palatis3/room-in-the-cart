        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos registros fueron ingresados por el hogar; no son precios de tiendas, saldos bancarios ni ahorros verificados."
          }
        }
      }
    },
    "This is a shop-plan envelope, not a posting-date statement. Later credits for assigned shops remain part of their entered evidence.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a shop-plan envelope, not a posting-date statement. Later credits for assigned shops remain part of their entered evidence."
          }
