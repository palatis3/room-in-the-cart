    "The exact reviewed record and action identity are saved for retry. A retry sends those same bytes; it does not create a second record.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The exact reviewed record and action identity are saved for retry. A retry sends those same bytes; it does not create a second record."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El registro exacto revisado y la identidad de la acción se guardan para reintentar. El reintento envía los mismos datos; no crea un segundo registro."
          }
        }
      }
    },
    "The local retry was cleared after checking current access and record status. This does not undo a saved record or confirm the original result.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The local retry was cleared after checking current access and record status. This does not undo a saved record or confirm the original result."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reintento local se borró tras verificar el acceso actual y el estado del registro. Esto no deshace un registro guardado ni confirma el resultado original."
          }
        }
      }
    },
    "The record was saved. Retry to finish clearing its local retry record.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The record was saved. Retry to finish clearing its local retry record."
          }
        },
