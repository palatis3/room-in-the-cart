            "state": "translated",
            "value": "El registro se guardó. Reintenta para terminar de borrar su registro local de reintento."
          }
        }
      }
    },
    "The result is not confirmed. Keep the original retry and reconcile it before starting another action.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The result is not confirmed. Keep the original retry and reconcile it before starting another action."
