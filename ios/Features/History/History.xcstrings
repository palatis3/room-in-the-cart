    "Deferring a purchase moves expected spending. It does not establish savings. Applying a reservation transfers the plan to its assigned shop instead of counting it twice.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deferring a purchase moves expected spending. It does not establish savings. Applying a reservation transfers the plan to its assigned shop instead of counting it twice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Posponer una compra cambia cuándo se espera gastar. No demuestra un ahorro. Aplicar una reserva transfiere el plan a su compra asignada, sin contarlo dos veces."
          }
        }
      }
    },
