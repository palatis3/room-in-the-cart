        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La revisión final debe ser posterior al cierre del período y no debe haber planes futuros reservados. La conciliación financiera aún depende de los registros actuales de cada compra."
          }
        }
      }
    },
