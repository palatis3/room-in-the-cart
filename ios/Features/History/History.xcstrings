    "A mass ounce and a fluid ounce are different units. Enter the quantity shown; no density conversion is inferred.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A mass ounce and a fluid ounce are different units. Enter the quantity shown; no density conversion is inferred."
