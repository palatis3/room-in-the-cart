      }
    },
    "The saved facts changed. Refresh and review a new action; an existing retry keeps its original bytes and revision.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved facts changed. Refresh and review a new action; an existing retry keeps its original bytes and revision."
