        }
      }
    },
    "Choose a reminder for this item. The notification contains no grocery or budget details.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a reminder for this item. The notification contains no grocery or budget details."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un recordatorio para este artículo. La notificación no incluye detalles de alimentos ni del presupuesto."
