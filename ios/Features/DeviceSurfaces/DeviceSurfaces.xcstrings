{
  "sourceLanguage": "en",
  "strings": {
    "Apply your line edits before saving or adding this list.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply your line edits before saving or adding this list."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica los cambios a cada artículo antes de guardar o agregar esta lista."
          }
        }
      }
    },
    "Start a new review for this pickup?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start a new review for this pickup?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Iniciar una nueva revisión para esta compra?"
          }
        }
      }
    },
    "Start new review": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start new review"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciar nueva revisión"
          }
        }
      }
    },
    "Your original shared text will be kept. Choices saved for the other pickup will be cleared.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your original shared text will be kept. Choices saved for the other pickup will be cleared."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se conservará el texto original que compartiste. Se borrarán las opciones guardadas para la otra compra."
