        }
      }
    },
    "Choose the original pickup to finish the interrupted import.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the original pickup to finish the interrupted import."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige la compra original para completar la importación interrumpida."
          }
        }
