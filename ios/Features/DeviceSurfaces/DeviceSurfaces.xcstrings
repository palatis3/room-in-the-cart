    },
    "Cancel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelar"
          }
        }
      }
    },
    "Choose a future time before the expiry and offer cutoff.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a future time before the expiry and offer cutoff."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una hora futura anterior al vencimiento y al límite de la oferta."
