{
  "sourceLanguage": "en",
  "strings": {
    "Items deferred to your next shop and store offers awaiting a decision appear here.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Items deferred to your next shop and store offers awaiting a decision appear here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí aparecen los artículos aplazados para tu próxima compra y las ofertas de la tienda que esperan tu decisión."
          }
        }
      }
    },
    "Choose one HTTPS recipe page, or share a plain-text shopping list.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose one HTTPS recipe page, or share a plain-text shopping list."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una página de recetas HTTPS o comparte una lista de compras en texto sin formato."
          }
        }
      }
    },
    "Could not save this link. In Import a recipe link, paste the address or remove an older shared link and try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not save this link. In Import a recipe link, paste the address or remove an older shared link and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar este enlace. En Importar un enlace de receta, pega la dirección o elimina un enlace compartido anterior e inténtalo de nuevo."
          }
        }
      }
    },
    "Open Import a recipe link in Room in the Cart to review this link within seven days.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Import a recipe link in Room in the Cart to review this link within seven days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Importar un enlace de receta en Room in the Cart para revisar este enlace en un plazo de siete días."
          }
        }
      }
    },
    "Save recipe link for review": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save recipe link for review"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar enlace de receta para revisar"
          }
        }
      }
    },
    "Use the selected text as a shopping list": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the selected text as a shopping list"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar el texto seleccionado como lista de compras"
          }
        }
      }
    },
    "Could not save recipe link": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not save recipe link"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar el enlace de la receta"
          }
        }
      }
    },
    "Recipe link": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recipe link"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enlace de receta"
          }
        }
      }
    },
    "Apply your line edits before saving or adding this list.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply your line edits before saving or adding this list."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica los cambios a cada artículo antes de guardar o agregar esta lista."
          }
        }
      }
    },
    "Start a new review for this pickup?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start a new review for this pickup?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Iniciar una nueva revisión para esta compra?"
          }
        }
      }
    },
    "Start new review": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start new review"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciar nueva revisión"
          }
        }
      }
    },
    "Your original shared text will be kept. Choices saved for the other pickup will be cleared.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your original shared text will be kept. Choices saved for the other pickup will be cleared."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se conservará el texto original que compartiste. Se borrarán las opciones guardadas para la otra compra."
          }
        }
      }
    },
    "Choose the original pickup to finish the interrupted import.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the original pickup to finish the interrupted import."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige la compra original para completar la importación interrumpida."
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelar"
          }
        }
      }
    },
    "Choose a future time before the expiry and offer cutoff.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a future time before the expiry and offer cutoff."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una hora futura anterior al vencimiento y al límite de la oferta."
          }
        }
      }
    },
    "Choose a reminder for this item. The notification contains no grocery or budget details.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a reminder for this item. The notification contains no grocery or budget details."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un recordatorio para este artículo. La notificación no incluye detalles de alimentos ni del presupuesto."
          }
        }
      }
    },
    "Choose a time outside quiet hours and before the deadline.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a time outside quiet hours and before the deadline."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una hora fuera del horario de silencio y antes del límite."
          }
        }
      }
    },
    "The share inbox is full. In Room in the Cart, open Shop, then Device shortcuts. Review or discard saved text to make room.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The share inbox is full. In Room in the Cart, open Shop, then Device shortcuts. Review or discard saved text to make room."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La bandeja de texto compartido está llena. En Room in the Cart, abre Compras y luego Accesos del dispositivo. Revisa o descarta el texto guardado para liberar espacio."
          }
        }
      }
    },
    "This device has reached its limit for shared lists. Open your shopping list in Room in the Cart and paste the text there.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device has reached its limit for shared lists. Open your shopping list in Room in the Cart and paste the text there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo alcanzó el límite de listas compartidas. Abre tu lista de compras en Room in the Cart y pega el texto allí."
          }
        }
      }
    },
