        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay acceso a Recordatorios. Puedes pegar abajo los títulos que hayas seleccionado."
          }
        }
      }
    },
    "Review duplicates before adding the copy. The original reminders and completion states stay in Reminders.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
