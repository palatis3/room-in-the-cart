    },
    "Reminders access is unavailable. You can paste selected titles below.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminders access is unavailable. You can paste selected titles below."
