          "stringUnit": {
            "state": "translated",
            "value": "El destino ha cambiado. Cierra esta pantalla y vuelve a elegir la compra."
          }
        }
      }
    },
    "The dinner changed. Reopen it to make a calendar copy.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The dinner changed. Reopen it to make a calendar copy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cena ha cambiado. Vuelve a abrirla para crear una copia en el calendario."
