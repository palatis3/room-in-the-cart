    "In the Calendar editor, review the title, time and destination calendar. People sharing that calendar may see the event.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the Calendar editor, review the title, time and destination calendar. People sharing that calendar may see the event."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa el título, la hora y el calendario de destino en el editor de Calendario. Quienes compartan ese calendario podrían ver el evento."
          }
        }
      }
    },
    "No reminder lists are available. You can paste selected titles below.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No reminder lists are available. You can paste selected titles below."
