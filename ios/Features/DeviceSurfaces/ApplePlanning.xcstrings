        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta lista no tiene recordatorios pendientes."
          }
        }
      }
    },
    "This is a one-time copy. Moving dinner in the meal plan will not move the calendar event.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a one-time copy. Moving dinner in the meal plan will not move the calendar event."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta es una copia independiente. Si cambias la cena de día en el plan, el evento del calendario conservará su fecha."
          }
        }
      }
