    "Choosing uses the accepted recipe's saved servings. It does not apply scenario portions, stock allocations, pack purchases or quoted costs.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choosing uses the accepted recipe's saved servings. It does not apply scenario portions, stock allocations, pack purchases or quoted costs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al elegir se usan las porciones guardadas de la receta aceptada. No se aplican las porciones del escenario, las asignaciones de existencias, las compras de paquetes ni los costos cotizados."
          }
        }
      }
