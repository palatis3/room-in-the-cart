            "value": "Review this list’s checkout copy to allocate confirmed pantry food to its meal needs. Saving the copy keeps pantry counts intact."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa la copia de compra de esta lista para asignar los alimentos confirmados a las comidas. Guardar la copia conserva las cantidades de la despensa."
          }
        }
      }
    },
