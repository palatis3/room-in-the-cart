    "Servings changed. Keep using these pantry amounts to leave these ingredients off your shopping list.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Servings changed. Keep using these pantry amounts to leave these ingredients off your shopping list."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambió el número de porciones. Si mantienes estas cantidades de la despensa, estos ingredientes quedarán fuera de tu lista de compras."
          }
        }
      }
    },
