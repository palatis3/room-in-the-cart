    "A recipe timer exceeds 12 hours. Its schedule step starts at 720 minutes. Review the duration before saving.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A recipe timer exceeds 12 hours. Its schedule step starts at 720 minutes. Review the duration before saving."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un temporizador de la receta supera las 12 horas. Su paso en el horario empieza con 720 minutos. Revisa la duración antes de guardar."
          }
        }
      }
    },
    "This schedule starts with the first 12 of %lld recipe steps. Review the remaining steps in the recipe before you save.": {
