    "preview": "vite preview --host 127.0.0.1"
  },
  "devDependencies": {
    "fake-indexeddb": "6.0.0",
    "jsdom": "26.0.0",
    "playwright-core": "1.65.0",
    "typescript": "5.7.3",
    "vite": "6.4.5"
  }
}
